# 复制为 .env 后填写（.env 已被 .gitignore 忽略，不会提交）。
# 也可在 GitHub 仓库 Settings > Secrets and variables 里配置同名变量。

# 站点地址（GitHub Pages 免费二级域名，把 <用户名> 换成你的；不填用代码内置默认值）
BASE_URL=https://<用户名>.github.io/smartpick

# 广告代码（AdSense 广告单元 <script> 整段粘贴；不需要可留空）
# 注：当前版本购买按钮未使用 AFF_ID，站点默认跳京东搜索；真实带佣链接请在
# products.seed.json 每个商品的 affUrl 字段填写。
AD_CODE=
